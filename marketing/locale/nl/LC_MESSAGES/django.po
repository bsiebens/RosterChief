msgid "up to 250 members · billed once per season · excl. 21%% VAT"
msgstr "tot 250 leden · eenmalig gefactureerd per seizoen · excl. 21%% btw"

#: templates/marketing/home.html:301
msgid "Everything in the demo, for good"
msgstr "Alles uit de demo, definitief"

#: templates/marketing/home.html:302
msgid "Invoicing, instalments, reminders"
msgstr "Facturatie, betaalschijven, herinneringen"

#: templates/marketing/home.html:303
msgid "Sign-up intake and approval"
msgstr "Inschrijvingen en goedkeuring"

#: templates/marketing/home.html:304
msgid "Public website on your own domain"
msgstr "Publieke website op je eigen domein"

#: templates/marketing/home.html:305
msgid "Your colours, crest and wordmark"
msgstr "Jouw kleuren, logo en naamstijl"

#: templates/marketing/home.html:306
msgid "Roles, rights and audit log"
msgstr "Rollen, rechten en logboek"

