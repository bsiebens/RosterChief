# Copy to .env — read by docker compose itself (not by Django).
ROSTERCHIEF_BASE_DOMAIN=rosterchief.app
ACME_EMAIL=you@example.com

# DNS-01 is the only way to get the *.rosterchief.app wildcard. Token needs DNS:Edit on the zone.
CLOUDFLARE_API_TOKEN=

POSTGRES_DB=rosterchief
# The superuser: used only by the first-boot init and deploy/backup.sh / restore-check.sh.
POSTGRES_USER=rosterchief
POSTGRES_PASSWORD=
# The role the app connects as (DJANGO_DATABASE_URL in .env.production), created on a FRESH db
# volume by deploy/postgres/10-app-role.sh. Not a superuser. An existing database is converted
# by hand -- see DEPLOYMENT.md, "Database roles". Password: openssl rand -hex 32.
APP_DB_USER=rosterchief_app
APP_DB_PASSWORD=

# age public key ("age1...", from `age-keygen`) that deploy/backup.sh encrypts every backup to.
# Required once BACKUP_REMOTE is used. The PRIVATE key never goes on this server -- see
# DEPLOYMENT.md, "Backups".
BACKUP_AGE_RECIPIENT=

# Which prebuilt image a plain `docker compose pull`/`up`/`run` uses from ghcr.io/bsiebens/rosterchief --
# a branch name ("main", "development"), a release ("v0.7.12") or "<branch>-<short-sha>".
# Don't edit it: every deploy (deploy-prod.sh/deploy-local.sh, deploy-dev.sh) rewrites this line
# with the tag it just deployed (deploy/record-image-tag.sh), so a by-hand `docker compose run`
# uses the image web is running. main is only the starting value (DEPLOYMENT.md, "Rollback").
IMAGE_TAG=main
