          "fields": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Validation messages per field; only on 422.",
            "title": "Fields"
          },
          "message": {
            "description": "Localised (Accept-Language), safe to show to the user.",
            "title": "Message",
            "type": "string"
          }
        },
