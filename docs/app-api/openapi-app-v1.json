  "info": {
    "description": "\nThe API the RosterChief native apps are built on. Read the developer guide first:\n**[/api/docs/](/api/docs/)**.\n\n* **Sign-in** is a separate API (allauth headless): `/api/auth/app/v1/`, spec at\n  [/api/auth/openapi.html](/api/auth/openapi.html). It returns the `access_token` used here.\n* **Authentication:** `Authorization: Bearer <access_token>` on every call except `/meta`.\n* **Two planes:** account endpoints (`/me`, `/clubs`, `/devices`, `/meta`) on the base domain;\n  club endpoints (`/context`, …) on the club's own host — take it from `api_base_url` in `/clubs`.\n* **Errors** always use `{\"error\": {\"code\", \"message\", \"fields\"}}`; branch on `code`.\n",
    "title": "RosterChief app API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/app/v1/clubs": {
      "get": {
        "description": "Every active club the account has a real tie to, with the base URL to use for that\nclub's endpoints. Cache it; offer a club picker when there is more than one.",
        "operationId": "appapi_routers_account_clubs",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubListOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "AppAuth": []
          }
        ],
        "summary": "Clubs the account can use",
        "tags": [
          "account"
        ]
      }
    },
    "/api/app/v1/context": {
      "get": {
        "description": "Call when a club is opened (and after pull-to-refresh): the season, the people the\naccount acts for (`member_id` values for other endpoints), coached teams, permissions\nand features. `403 not_a_member` means the account has no tie to this club.",
        "operationId": "appapi_routers_club_context",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "AppAuth": []
          }
        ],
        "summary": "The caller in this club",
        "tags": [
          "club"
        ]
      }
    },
    "/api/app/v1/devices": {
      "post": {
        "description": "Call after sign-in and whenever the push token changes (iOS may rotate it). Keyed by\n`installation_id`: repeating the call updates the same registration. If another account\nregistered this install before, it moves to the signed-in account.",
        "operationId": "appapi_routers_account_register_device",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "security": [
          {
            "AppAuth": []
          }
        ],
        "summary": "Register this install for push",
        "tags": [
          "account"
        ]
      }
    },
    "/api/app/v1/devices/{installation_id}": {
      "delete": {
        "description": "Call on sign-out, before discarding the tokens. Only the account's own installs.",
        "operationId": "appapi_routers_account_unregister_device",
        "parameters": [
          {
            "in": "path",
            "name": "installation_id",
            "required": true,
            "schema": {
              "title": "Installation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "AppAuth": []
          }
        ],
        "summary": "Unregister this install",
        "tags": [
          "account"
        ]
      }
    },
    "/api/app/v1/me": {
      "get": {
        "operationId": "appapi_routers_account_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "AppAuth": []
          }
        ],
        "summary": "The signed-in account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/app/v1/meta": {
      "get": {
        "description": "No authentication. Call on launch: if the app's version is below\n`min_supported_app_version`, show an 'update required' screen.",
        "operationId": "appapi_routers_account_meta",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaOut"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
