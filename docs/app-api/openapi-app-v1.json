            "title": "Environment",
            "type": "string"
          },
          "installation_id": {
            "description": "A random id the app generates once per install (e.g. a UUID) and keeps in the Keychain.",
            "maxLength": 64,
            "minLength": 8,
            "title": "Installation Id",
            "type": "string"
          },
          "locale": {
            "default": "",
            "description": "The app's language, e.g. `nl` or `en`; push texts are written in it.",
            "maxLength": 16,
            "title": "Locale",
            "type": "string"
          },
          "platform": {
            "enum": [
              "ios",
              "android"
            ],
            "title": "Platform",
            "type": "string"
          },
          "push_token": {
            "description": "The APNs device token as a hex string (iOS) or the FCM registration token (Android).",
            "maxLength": 512,
            "minLength": 1,
            "title": "Push Token",
            "type": "string"
          }
        },
        "required": [
          "installation_id",
          "platform",
          "push_token"
        ],
        "title": "DeviceIn",
        "type": "object"
      },
      "DeviceOut": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "installation_id": {
            "title": "Installation Id",
            "type": "string"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "push_enabled": {
            "description": "False until the server can deliver pushes to this device (SNS configured, token accepted).",
