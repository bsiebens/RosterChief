DJANGO_DEBUG=False
DJANGO_SECRET_KEY=@SECRET_KEY@
DJANGO_ALLOWED_HOSTS=.@BASE_DOMAIN@
DJANGO_DATABASE_URL=postgresql:///rosterchief
DJANGO_TRUST_PROXY_SSL_HEADER=True
ROSTERCHIEF_BASE_DOMAIN=@BASE_DOMAIN@
DJANGO_MEDIA_ROOT=/var/lib/rosterchief/media
DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/rosterchief/private_media
CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

FRONTEND_CONTROLPANEL_URL=https://control.@BASE_DOMAIN@
FRONTEND_MANAGEMENT_URL=/
FRONTEND_MEMBER_URL=/

# Email. Until one of these is set, mail is only printed to the log and nobody can verify an address. Pick ONE:
# 1) Resend's HTTP API (what the previous version used):
# RESEND_API_KEY=re_...
# 2) Any SMTP provider, Resend's relay included (smtp.resend.com, user "resend", the API key as password), or Amazon SES.
# DJANGO_FROM_EMAIL must be an address on a domain verified with the provider.
# DJANGO_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# DJANGO_SMTP_PORT=587
# DJANGO_SMTP_USER=
# DJANGO_SMTP_PASSWORD=
# DJANGO_SMTP_TLS=True
# DJANGO_FROM_EMAIL=RosterChief <accounts@@BASE_DOMAIN@>
# 3) Staging only, no sending domain (an sslip.io host): mail stays in the log, and this acknowledges Django's deploy check mail.E001.
# DJANGO_MAIL_TO_LOG=True
