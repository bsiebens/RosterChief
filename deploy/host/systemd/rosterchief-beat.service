[Unit]
Description=RosterChief Celery scheduler
After=network.target postgresql.service valkey.service
Requires=postgresql.service valkey.service

[Service]
User=rosterchief
Group=rosterchief
WorkingDirectory=/opt/rosterchief/current
EnvironmentFile=/etc/rosterchief/app.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rosterchief/current/.venv/bin/celery -A rosterchief beat --loglevel=INFO --pidfile=
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
