# Local machine config for deploy/deploy-dev.sh and deploy/deploy-prod.sh -- NOT read by the
# server or by docker compose (that's .env/.env.production, see .env.compose.example). Copy
# this per target you deploy to and `source` it before running the matching script:
#
#   cp deploy/.env.deploy.example deploy/.env.prod.local   # gitignored, never committed
#   # fill it in, then:
#   source deploy/.env.prod.local && deploy/deploy-prod.sh
#
# Keeping separate .local files per target (e.g. .env.dev.local / .env.prod.local) beats one
# shared shell profile export when you deploy to more than one place -- each script call stays
# explicit about which target it's talking to instead of relying on whatever's currently
# exported in your shell.

export SSH_HOST=                # e.g. 203.0.113.10, or a hostname from your ~/.ssh/config
export SSH_USER=                # e.g. bernard
export REMOTE_DIR=               # e.g. /home/bernard/RosterChief

# Optional: authenticate with this specific private key instead of whatever ssh-agent/default
# identity would otherwise be tried. Leave unset to use your normal SSH setup (agent, default
# keys, ~/.ssh/config Host block, ...) -- most setups don't need this set at all.
export SSH_KEY_FILE=             # e.g. ~/.ssh/rosterchief_deploy
