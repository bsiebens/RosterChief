# Copy to production.env and fill in. Secrets go in production.secrets, never here.
BASE_DOMAIN=example.com
OWNER_EMAIL=owner@example.com
# Sizing, applied by `rc provision` (then deploy). standard (default): no limits, for 4 GB and up. medium: a 2 GB host, with memory
# caps on every service and a sized PostgreSQL and Valkey. See docs/deployment.md.
# PROFILE=medium
GITHUB_REPO=your-org/RosterChief
CLOUDFLARE_PROXIED=true
TRUSTED_CIDR=10.0.0.0/16

# A release must already be running on every host of this environment before it can be deployed here
# (override once with `rc deploy production vX.Y.Z --force`).
PROMOTE_FROM=staging

HOSTS=(
  "app1 full ssh ec2-user@203.0.113.30"
)
