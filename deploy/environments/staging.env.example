# Copy to staging.env and fill in. Secrets go in staging.secrets (see secrets.example), never here.
BASE_DOMAIN=staging.example.com
OWNER_EMAIL=owner@example.com
GITHUB_REPO=your-org/RosterChief

# Is the domain proxied by Cloudflare (orange cloud)? true: Caddy trusts CF-Connecting-IP from Cloudflare's
# ranges only. false: Caddy trusts no forwarded header. Change later with `rc proxy staging on|off`.
CLOUDFLARE_PROXIED=true

# Private network of the frontend host(s); a backend host accepts the frontend's forwarded headers from here.
# Only needed when a backend host is listed.
TRUSTED_CIDR=10.0.0.0/16

# One line per server:  "name role transport target [key=value ...]"
#   role       full | backend | frontend
#   transport  ssh (target user@host, key auth, passwordless sudo) | ssm (target is the instance id)
#   options    private_ip=10.0.1.5   (backend: the address its private listener binds to; frontends reach it there)
#              region=eu-west-1      (ssm hosts: override the AWS region)
# Single server running everything:
HOSTS=(
  "app1 full ssh ec2-user@203.0.113.10"
)
# Split frontend and backend:
# HOSTS=(
#   "api1 backend ssm i-0123456789abcdef0 private_ip=10.0.1.5 region=eu-west-1"
#   "web1 frontend ssh ec2-user@203.0.113.20"
# )
