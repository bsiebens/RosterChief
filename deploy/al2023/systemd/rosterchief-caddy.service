[Unit]
Description=RosterChief Caddy TLS reverse proxy
Wants=network-online.target
After=network-online.target

[Service]
User=caddy
Group=caddy
EnvironmentFile=/etc/rosterchief/site.env
Environment=XDG_DATA_HOME=/var/lib/caddy/data XDG_CONFIG_HOME=/var/lib/caddy/config
ExecStartPre=/usr/local/bin/caddy validate --config /etc/rosterchief/Caddyfile --adapter caddyfile
ExecStart=/usr/local/bin/caddy run --config /etc/rosterchief/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/rosterchief/Caddyfile --adapter caddyfile
Restart=on-failure
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy

[Install]
WantedBy=multi-user.target
