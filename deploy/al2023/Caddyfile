{
	email {$CADDY_ACME_EMAIL}
}

{$ROSTERCHIEF_BASE_DOMAIN}, *.{$ROSTERCHIEF_BASE_DOMAIN} {
	tls {
		dns route53
	}
	encode zstd gzip

	handle_path /static/* {
		root * /opt/rosterchief/current/staticfiles
		file_server
	}
	handle_path /media/* {
		root * /var/lib/rosterchief/media
		header X-Content-Type-Options nosniff
		file_server
	}

	@control host control.{$ROSTERCHIEF_BASE_DOMAIN}
	handle @control {
		@django path /healthz /admin /admin/* /accounts /accounts/* /_allauth/browser/*
		handle @django {
			reverse_proxy 127.0.0.1:8000 {
				header_up Host {$ROSTERCHIEF_BASE_DOMAIN}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:5173
		}
	}

	@django path /healthz /admin /admin/* /accounts /accounts/* /_allauth/browser/*
	handle @django {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:5174
	}
}
