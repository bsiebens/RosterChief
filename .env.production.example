# Copy to .env.production and fill in. Everything here is read by python-decouple.

# --- Django ---
DJANGO_SECRET_KEY=          # python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=False
# The leading dot matches every club subdomain.
DJANGO_ALLOWED_HOSTS=.rosterchief.app
# Only needed for a genuinely cross-origin POST, and nothing in the app makes one: every form
# posts to its own host, which Django's Origin check accepts without being listed here. Don't
# add a `https://*.rosterchief.app` wildcard -- it would let any club subdomain post to any other.
DJANGO_CSRF_TRUSTED_ORIGINS=https://rosterchief.app
DJANGO_TIME_ZONE=Europe/Brussels

# --- Tenancy ---
# Drives subdomain resolution, the shared session cookie, and the WebAuthn RP ID (one passkey
# across every club).
ROSTERCHIEF_BASE_DOMAIN=rosterchief.app
ROSTERCHIEF_RP_NAME=RosterChief

# --- Two-factor secrets (required) ---
# Encrypts TOTP secrets and recovery-code seeds at rest. Generate with
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy OUTSIDE the server and its backups -- losing it locks every TOTP user out.
# Rotate with "new,old" (first encrypts, all decrypt). See DEPLOYMENT.md, "Two-factor secrets".
MFA_ENCRYPTION_KEY=

# --- Services ---
# The non-superuser app role (APP_DB_USER/APP_DB_PASSWORD in .env), not POSTGRES_USER -- see
# DEPLOYMENT.md, "Database roles". Use a password without URL-special characters (openssl rand -hex 32).
DJANGO_DATABASE_URL=postgres://rosterchief_app:CHANGEME@db:5432/rosterchief
DJANGO_REDIS_URL=redis://redis:6379/0

# --- HTTPS (off by default in code; the deploy is what turns them on) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Preload is a one-way door — turn it on only once the wildcard cert has proven itself.
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Static ---
DJANGO_STATICFILES_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage

# --- Uploads: set these and club logos move off local disk (required for >1 app server) ---
# AWS_STORAGE_BUCKET_NAME=rosterchief-media
# AWS_S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
# AWS_S3_REGION_NAME=fsn1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email: any SMTP provider. Left unset, mail is PRINTED TO THE LOG and never delivered,
# which means send_billing_reminders will look like it worked while no club hears from you.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=RosterChief <noreply@rosterchief.app>
# Where a club is told to reply with a billing question.
ROSTERCHIEF_BILLING_CONTACT_EMAIL=billing@rosterchief.app
# Where the marketing site's "Book a demo" requests are sent.
# ROSTERCHIEF_CONTACT_EMAIL=you@example.com

# --- Email via Resend (resend.com), as an alternative to the SMTP block above ---
# Two ways to use Resend; pick one, don't set both:
#   1. Resend's SMTP relay -- no code involved, just point the SMTP settings above at it:
#        DJANGO_EMAIL_HOST=smtp.resend.com
#        DJANGO_EMAIL_HOST_USER=resend
#        DJANGO_EMAIL_HOST_PASSWORD=<your Resend API key>
#   2. Resend's HTTP API via rosterchief.mail.ResendEmailBackend (see that module):
#        DJANGO_EMAIL_BACKEND=rosterchief.mail.ResendEmailBackend
#        RESEND_API_KEY=<your Resend API key>
RESEND_API_KEY=

# --- Web Push (mobile app). Optional: without a private key, push is off. One pair for the
# whole platform; generate it on your own machine with `uv run vapid --gen`.
# DJANGO_VAPID_PUBLIC_KEY=
# DJANGO_VAPID_PRIVATE_KEY=
# DJANGO_VAPID_ADMIN_EMAIL=admin@rosterchief.app

# --- Native app push (iOS now, Android later) through Amazon SNS. Optional: without an ARN
# the app still registers but gets no pushes. Setup: DEPLOYMENT.md "Native app push".
# APP_PUSH_SNS_REGION=eu-west-1
# APP_PUSH_SNS_ACCESS_KEY_ID=
# APP_PUSH_SNS_SECRET_ACCESS_KEY=
# APP_PUSH_SNS_APNS_ARN=arn:aws:sns:eu-west-1:<account>:app/APNS/rosterchief-ios-prod
# APP_PUSH_SNS_APNS_SANDBOX_ARN=arn:aws:sns:eu-west-1:<account>:app/APNS_SANDBOX/rosterchief-ios-prod-sandbox
# Oldest app versions still allowed (GET /meta); raise to force an update.
# APP_MIN_VERSION_IOS=1.0.0
