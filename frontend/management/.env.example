# Django backend the app forwards to (server-side only).
BACKEND_URL=http://localhost:8000
# Bare domain of the platform. A club is served on <slug>.<base>; the app forwards the browser's own Host header to
# Django, which picks the club from it.
#  - Development: "localhost" means http://acme.localhost:5174 -> club "acme", http://localhost:5174 -> club picker.
#    The session cookie then stays host-only (see README).
#  - Production: e.g. rosterchief.app. The session cookie gets Domain=.rosterchief.app, so one sign-in covers the bare
#    domain and every club subdomain.
ROSTERCHIEF_BASE_DOMAIN=localhost
# Optional: force the Host header sent to Django (odd setups only).
# BACKEND_HOST=
